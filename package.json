{
  "name": "esutils",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esutils/esutils.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build tsconfig.mjs.json",
    "build-workspaces": "yarn workspaces foreach -A -t run build",
    "check": "tsc --noEmit --project tsconfig.json",
    "test-only": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.ts",
    "test": "yarn run build && yarn run test-only",
    "lint": "vite build",
    "pack": "yarn workspace @esutils/dns-packet run vite",
    "mase": "node packages/mase/dist/cli.mjs",
    "rmdir:esutils": "rimraf node_modules/@esutils",
    "install:safe": "yarn rmdir:esutils && yarn install && yarn build",
    "sync-mase": "tsx scripts/sync-mase.ts",
    "watch": " tsc --build --watch tsconfig.mjs.json"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-checker": "^0.14.4"
  },
  "packageManager": "yarn@4.17.0"
}
